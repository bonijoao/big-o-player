{"exemplo": {"dados": "n = 10", "n": 10, "fatorial": "3628800", "ops": 9, "pico": 10, "eventos": [["entra", 10], ["entra", 9], ["entra", 8], ["entra", 7], ["entra", 6], ["entra", 5], ["entra", 4], ["entra", 3], ["entra", 2], ["entra", 1], ["sai"], ["multiplica", 2, 2], ["sai"], ["multiplica", 3, 6], ["sai"], ["multiplica", 4, 24], ["sai"], ["multiplica", 5, 120], ["sai"], ["multiplica", 6, 720], ["sai"], ["multiplica", 7, 5040], ["sai"], ["multiplica", 8, 40320], ["sai"], ["multiplica", 9, 362880], ["sai"], ["multiplica", 10, 3628800], ["sai"]]}, "tempo": {"unidade": "multiplicações", "tipo": "fatorial", "series": [{"caso": "unico", "nome": "fatorial(n)"}], "crescimento": [{"n": 4, "unico": {"ops": 3, "pico": 4}}, {"n": 8, "unico": {"ops": 7, "pico": 8}}, {"n": 16, "unico": {"ops": 15, "pico": 16}}, {"n": 32, "unico": {"ops": 31, "pico": 32}}, {"n": 64, "unico": {"ops": 63, "pico": 64}}, {"n": 128, "unico": {"ops": 127, "pico": 128}}, {"n": 256, "unico": {"ops": 255, "pico": 256}}], "eixo": "n (dobra a cada passo)", "refs": ["n"], "refs_memoria": ["n"], "crescimento_dados": "uma chamada por n: as contas só dependem de n"}, "memoria": {"pico": 10, "detalhe": {"pilha": 10}}, "ciclomatica": {"M": 2, "nos": 10, "arestas": 10, "decisoes": [{"linha": 3, "tipo": "if"}], "grafo": {"nos": [{"id": 0, "linha": 1, "rotulo": "início"}, {"id": 1, "linha": 2, "rotulo": "expr"}, {"id": 2, "linha": 3, "rotulo": "if"}, {"id": 3, "linha": 4, "rotulo": "assign"}, {"id": 4, "linha": 6, "rotulo": "assign"}, {"id": 5, "linha": 7, "rotulo": "expr"}, {"id": 6, "linha": 8, "rotulo": "expr"}, {"id": 7, "linha": 9, "rotulo": "expr"}, {"id": 8, "linha": 10, "rotulo": "return"}, {"id": 9, "linha": 11, "rotulo": "fim"}], "arestas": [{"de": 0, "para": 1, "tipo": "segue"}, {"de": 1, "para": 2, "tipo": "segue"}, {"de": 2, "para": 3, "tipo": "segue"}, {"de": 2, "para": 4, "tipo": "segue"}, {"de": 4, "para": 5, "tipo": "segue"}, {"de": 5, "para": 6, "tipo": "segue"}, {"de": 3, "para": 7, "tipo": "segue"}, {"de": 6, "para": 7, "tipo": "segue"}, {"de": 7, "para": 8, "tipo": "segue"}, {"de": 8, "para": 9, "tipo": "segue"}]}, "codigo": "def fatorial(n, conta):\n    conta.entra(n)\n    if n <= 1:\n        r = 1\n    else:\n        r = n * fatorial(n - 1, conta)\n        conta.op(\"multiplicacoes\")\n        conta.evento(\"multiplica\", n, r)\n    conta.sai()\n    return r\n"}, "conferir": [{"n": 0, "fatorial": "1", "ops": 0, "pico": 1}, {"n": 1, "fatorial": "1", "ops": 0, "pico": 1}, {"n": 2, "fatorial": "2", "ops": 1, "pico": 2}, {"n": 3, "fatorial": "6", "ops": 2, "pico": 3}, {"n": 4, "fatorial": "24", "ops": 3, "pico": 4}, {"n": 5, "fatorial": "120", "ops": 4, "pico": 5}, {"n": 6, "fatorial": "720", "ops": 5, "pico": 6}, {"n": 7, "fatorial": "5040", "ops": 6, "pico": 7}, {"n": 8, "fatorial": "40320", "ops": 7, "pico": 8}, {"n": 9, "fatorial": "362880", "ops": 8, "pico": 9}, {"n": 10, "fatorial": "3628800", "ops": 9, "pico": 10}, {"n": 11, "fatorial": "39916800", "ops": 10, "pico": 11}, {"n": 12, "fatorial": "479001600", "ops": 11, "pico": 12}, {"n": 13, "fatorial": "6227020800", "ops": 12, "pico": 13}, {"n": 14, "fatorial": "87178291200", "ops": 13, "pico": 14}, {"n": 15, "fatorial": "1307674368000", "ops": 14, "pico": 15}, {"n": 16, "fatorial": "20922789888000", "ops": 15, "pico": 16}, {"n": 17, "fatorial": "355687428096000", "ops": 16, "pico": 17}, {"n": 18, "fatorial": "6402373705728000", "ops": 17, "pico": 18}, {"n": 19, "fatorial": "121645100408832000", "ops": 18, "pico": 19}, {"n": 20, "fatorial": "2432902008176640000", "ops": 19, "pico": 20}]}